{
  "manifest_version": 3,
  "key": "",
  "name": "Huddle AI",
  "version": "0.1.270",
  "description": "Live insights, captions and minutes for your Slack huddles — right in the side panel.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Huddle AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://app.slack.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.cerebras.ai/*",
    "https://api.mistral.ai/*",
    "https://api.cloudflare.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "536005382939-c0fdtsb58didvtb250vf47v453os4agh.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "scanner.js",
        "page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
